# Copy to .env.local (git-ignored) or let `lk app env -w` write it for you.
# STT (Deepgram), LLM (Gemma) and TTS (Inworld) all go through LiveKit Inference,
# so these three LiveKit values are the only credentials needed.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
